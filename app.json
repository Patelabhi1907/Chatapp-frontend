      },
      "package": "com.chatapp",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "f2595c73-d6b2-41ea-874f-d7656d3a7586"
      }
    }
  }
}
